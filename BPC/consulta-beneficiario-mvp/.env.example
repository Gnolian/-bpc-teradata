TD_HOST=
TD_USER=
TD_PASSWORD=
TD_LOGMECH=LDAP
TD_DATABASE=
TD_TABLE=

# Para nao editar o .env principal a cada carga, crie arquivos locais como
# .env.preparar_202605 ou .env.carregar_202605 e rode:
# python -u -m scripts.carregar_referencias_teradata --env-file .env.preparar_202605
# python -u -m scripts.atualizar_base_sqlite --env-file .env.carregar_202605

# Preparacao da tabela Teradata de origem da aplicacao.
# Use TD_REF_COMPLETAS quando a view Macica x CadUnico ja existir.
# Use TD_REF_MACICA_SOMENTE para atualizar provisoriamente a Consulta Pessoa
# enquanto a view cruzada ainda nao foi publicada.
TD_REF_COMPLETAS=
TD_REF_MACICA_SOMENTE=
TD_REF_SQL_MODELO_COMPLETO=sql/consulta_modelo_referencias.sql
TD_REF_APAGAR_ANTES_DE_INSERIR=false
TD_REF_PARAR_NO_PRIMEIRO_ERRO=true
TD_REF_CADUNICO_MESMO_MES=202201,202202

TD_COMPETENCIA=202601
TD_COMPETENCIAS=

MODO_CARGA=streaming
TD_FETCH_SIZE=75000
MAX_WORKERS=1
TD_MAX_RETRIES=4
TD_RETRY_BASE_SECONDS=15
TD_AUTH_MAX_RETRIES=5
TD_AUTH_RETRY_BASE_SECONDS=15
TD_STREAM_MAX_RETRIES=50
TD_STREAM_RETRY_BASE_SECONDS=3
TD_KEYSET_CAST_CHAVE=true
TD_PROGRESS_COUNT_PHASES=true
OTIMIZAR_INSERCAO_SQLITE=true
SQLITE_REBUILD_INDEXES_ON_LOAD=preserve
SQLITE_RECREATE_INDEXES_AFTER_LOAD=true
SQLITE_ALLOW_INDEX_REBUILD=false
SQLITE_REBUILD_INDEX_THRESHOLD_ROWS=2000000
SQLITE_CREATE_OPTIONAL_INDEXES=false
SQLITE_FAST_LOAD=false
SQLITE_ALLOW_UNSAFE_SYNCHRONOUS_OFF=false
SQLITE_LOAD_JOURNAL_MODE=WAL
SQLITE_LOAD_EXCLUSIVE=false
SQLITE_WRITE_RETRIES=8
SQLITE_WRITE_RETRY_SECONDS=2
SQLITE_WAL_CHECKPOINT_LOTES=10
SQLITE_WAL_TRUNCATE_LOTES=50
SQLITE_CALCULATE_METRICS_ON_LOAD=false
SQLITE_DEDUP_FIRST_RESUME_LOTE=false
SQLITE_LOG_LOTE_TIMING=true
SQLITE_PROGRESS_COUNT_LOCAL=true
SQLITE_RESUME_COUNT_LOCAL=false
SQLITE_INDEX_VERBOSE=true
SQLITE_INDEX_PROGRESS_SECONDS=60
SQLITE_INDEX_PROGRESS_OPS=50000
SQLITE_INDEX_CACHE_MB=1024
SQLITE_INDEX_THREADS=4
SQLITE_INDEX_SYNCHRONOUS=FULL
SQLITE_ALLOW_UNSAFE_INDEX_SYNCHRONOUS_OFF=false
SQLITE_INDEX_JOURNAL_MODE=WAL
SQLITE_INDEX_EXCLUSIVE=true
SQLITE_ANALYZE_AFTER_INDEXES=false

MACICA_DIRETA_APAGAR_SQLITE_ANTES=true
MACICA_DIRETA_RETOMAR=true
MACICA_DIRETA_FORCAR_RECARGA=false
MACICA_DIRETA_CALCULAR_METRICAS=true

FORCAR_RECARGA=false
RECRIAR_ESTRUTURA_API=false
FORCAR_FASES=

ADMIN_DEFAULT_PASSWORD=
USUARIO_SENHA_PADRAO=
SQLITE_TIMEOUT_SECONDS=60
SQLITE_DB_PATH=data/beneficiarios.db
SQLITE_MIN_FREE_GB=10
SQLITE_SPACE_CHECK_LOTES=5
